config ctstat 'global'
	option enabled '1'
	option apps '1'
	option dns_names '1'
	option dns_iface 'br-lan'
	# Comma-separated DNS capture interfaces are supported, e.g. 'br-lan,br-guest'.
	option backend 'auto'
	option attr_totals '1'
	option attr_topapps '0'
	# memory guard: restart a background process that grew by more than mem_limit_mb since its start
	option mem_guard '1'
	option mem_limit_mb '48'
	# history storage per resolution (internal flash: /etc/ctstat-data, SD card: /mnt/...)
	#option persist_dir '/mnt/sda1/ctstat'
	#option persist_dir_5m ''
	#option persist_dir_1h ''
	#option persist_dir_1d '/etc/ctstat-data'
	option domain_auto_update '1'
	option domain_update_days '7'

	# V2Fly category groups that trigger history warning markers
	option alert_groups 'category-porn'
	# Optional legacy application-name matching. Plain terms are substring matches; * and ? are wildcards.
	option alert_keywords ''
